parameters:
    level: 5
    phpVersion: 80100
    tmpDir: /tmp/phpstan/AnonymousPiwikUsageMeasurement/main
    paths:
        - .
    excludePaths:
        analyseAndScan:
            - tests/*
            # The shared workflow leaves this helper checkout in the workspace, and `paths: .`
            # would otherwise analyse it as if it were plugin code.
            - github-action-tests/*
    ignoreErrors:
        # scanDirectories pulls in core's tests/PHPUnit/bootstrap.php, which does
        # define('PIWIK_TEST_MODE', true), so the constant reads as always true here. In
        # production it is undefined and the guard is load-bearing.
        -
            message: '#Right side of && is always true#'
            path: Tracker/Targets.php
    bootstrapFiles:
        - ../../bootstrap-phpstan.php
    universalObjectCratesClasses:
        - Piwik\Config
        - Piwik\View
        - Piwik\ViewDataTable\Config
    scanDirectories:
        - ../../
